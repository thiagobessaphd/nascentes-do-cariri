# MySQL. Use apenas caracteres URL-safe na senha ou informe DATABASE_URL codificada.
MYSQL_DATABASE=nascentes_do_cariri
MYSQL_USER=nascentes_app
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
DATABASE_URL=mysql://nascentes_app:troque-esta-senha@mysql:3306/nascentes_do_cariri

# Aplicação e autenticação
APP_URL=http://localhost:8080
AUTH_URL=http://localhost:8080
AUTH_SECRET=gere-com-openssl-rand-base64-32
MAX_UPLOAD_SIZE_BYTES=5242880

# Vercel Blob privado. Obrigatório quando o fluxo de importação for implementado.
BLOB_READ_WRITE_TOKEN=

# Tiles de desenvolvimento. Escolha um provedor com capacidade/SLA antes da produção.
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_TILE_MAX_ZOOM=19

# Nginx
SERVER_NAME=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
HTTPS_REDIRECT_PORT=:8443

# Usadas apenas com docker-compose.tls.yml
TLS_CERTIFICATE_FILE=./certs/fullchain.pem
TLS_PRIVATE_KEY_FILE=./certs/privkey.pem
